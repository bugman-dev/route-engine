# Copy to .env and adjust as needed:
#   cp .env.sample .env          # macOS / Linux
#   copy .env.sample .env        # Windows

# Distance provider: haversine | osrm
ROUTE_ENGINE_PROVIDER=haversine

# OSRM Table API base URL (used when ROUTE_ENGINE_PROVIDER=osrm)
# Public demo server — fine for local experiments; use your own in production.
OSRM_BASE_URL=https://router.project-osrm.org
