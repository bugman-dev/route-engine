# Copy to .env and adjust as needed:
#   cp .env.sample .env          # macOS / Linux
#   copy .env.sample .env        # Windows

# Default travel provider when the request omits "provider": haversine | osrm
ROUTE_ENGINE_PROVIDER=haversine

# Default OR-Tools cost when the request omits "cost_mode": distance | eta
# With haversine, distance is always used (eta is ignored).
# With osrm, both matrices are built; the chosen one is minimized and
# both distance and duration are returned on each route.
ROUTE_ENGINE_COST=distance

# OSRM Table API base URL (used when provider is osrm)
# Public demo server — fine for local experiments; use your own in production.
OSRM_BASE_URL=https://router.project-osrm.org
