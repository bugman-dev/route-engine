# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Distribution / packaging
build/
dist/
*.egg-info/
src/*.egg-info/

# Test & coverage reports
.coverage
htmlcov/
.pytest_cache/

# IDE settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment variables (keep .env.sample committed)
.env

# Logs
*.log

# ---------------------------------------------------------------------------
# OSRM map extracts and prepared graph (large; never commit)
# Keep only osrm-data/README.md in the repo.
# ---------------------------------------------------------------------------
osrm-data/*
!osrm-data/README.md

# Catch OSRM / OSM artifacts anywhere else in the tree
*.osm.pbf
*.osm
*.osrm
*.osrm.*
