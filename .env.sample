# Copy to .env and adjust as needed:
#   cp .env.sample .env          # macOS / Linux
#   copy .env.sample .env        # Windows

# Default travel provider when the request omits "provider": haversine | osrm
# Keep haversine until OSRM map data is prepared; then switch to osrm.
ROUTE_ENGINE_PROVIDER=haversine

# Default OR-Tools cost when the request omits "cost_mode": distance | eta
# With haversine, distance is always used (eta is ignored).
# With osrm, both matrices are built; the chosen one is minimized and
# both distance and duration are returned on each route.
ROUTE_ENGINE_COST=distance

# OSRM Table API base URL (used when provider is osrm).
# - Local (non-Docker) against a host OSRM: http://localhost:5000
# - Public demo (dev only): https://router.project-osrm.org
# - docker compose overrides this to http://osrm:5000 for the app service
OSRM_BASE_URL=https://router.project-osrm.org

# Basename of the prepared map under osrm-data/ (no extension).
# Example: file osrm-data/southern-zone-260718.osm.pbf → OSRM_MAP=southern-zone-260718
# Used by docker-compose for the osrm service command.
# Map files in osrm-data/ are gitignored — see README "OSRM map data".
OSRM_MAP=region
