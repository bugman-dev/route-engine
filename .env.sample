# Copy to .env and adjust as needed:
#   cp .env.sample .env          # macOS / Linux
#   copy .env.sample .env        # Windows

# ---------------------------------------------------------------------------
# Route engine (internal)
# ---------------------------------------------------------------------------

# Default travel provider when the engine request omits "provider": haversine | osrm
ROUTE_ENGINE_PROVIDER=haversine

# Default OR-Tools cost when the engine request omits "cost_mode": distance | eta
ROUTE_ENGINE_COST=distance

# OSRM Table API base URL (used when provider is osrm).
# docker compose overrides this to http://osrm:5000 for the route-engine service.
OSRM_BASE_URL=https://router.project-osrm.org

# Basename of the prepared map under osrm-data/ (no extension).
OSRM_MAP=region

# ---------------------------------------------------------------------------
# Orchestrator + MySQL (public API on :8080)
# ---------------------------------------------------------------------------

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=route_engine
MYSQL_USER=route
MYSQL_PASSWORD=route

# Used when running the orchestrator outside Compose.
DATABASE_URL=mysql+pymysql://route:route@127.0.0.1:3306/route_engine
ENGINE_BASE_URL=http://127.0.0.1:8000
ORCHESTRATOR_TZ=Asia/Kolkata
ENGINE_HTTP_TIMEOUT_SECONDS=60
# Short timeout for GET /health probes of engine + OSRM
HEALTH_HTTP_TIMEOUT_SECONDS=3
